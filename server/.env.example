# LLM Provider Options:
# 'free_agent'  = Zero-cost built-in AI receptionist engine (No API key required!)
# 'openrouter'  = Free & paid models via OpenRouter (e.g., google/gemini-2.0-flash-lite-preview:free)
# 'gemini'      = Free Google AI Studio key (gemini-1.5-flash / gemini-2.0-flash)
# 'ollama'      = Local offline Ollama server (http://localhost:11434)
# 'anthropic'   = Anthropic Claude API key
LLM_PROVIDER=free_agent

# Free / Preferred API Keys (leave blank for free_agent)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model selection
AI_MODEL=google/gemini-2.0-flash-lite-preview:free

# Retrieval Provider: 'local' (Transformers.js vector search) or 'bm25' (keyword fallback)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Clinic Details
CLINIC_NAME=SmileCare Dental Clinic
CLINIC_TZ=Asia/Kolkata
PORT=3001
