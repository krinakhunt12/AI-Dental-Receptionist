datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  CLINIC_OWNER
  DOCTOR
  STAFF
}

enum CareProtocolStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum CarePhase {
  PRE_OP
  POST_OP
}

enum CareCategory {
  HYDRATION
  DIET
  MEDICATION
  ACTIVITY
  HYGIENE
  FASTING
  OTHER
}

enum EscalationAction {
  CALL_CLINIC
  EMERGENCY
  NOTIFY_STAFF
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  AI
  PHONE
  MANUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ESCALATED
}

enum CallStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
}

model Plan {
  id                      String         @id @default(uuid())
  name                    String         @unique
  code                    String         @unique
  priceMonthly            Decimal        @db.Decimal(10, 2)
  priceYearly             Decimal        @db.Decimal(10, 2)
  maxDoctors              Int
  maxAppointmentsPerMonth Int
  maxAiCallsPerMonth      Int
  features                Json?
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  subscriptions           Subscription[]
}

model Clinic {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  email         String
  phone         String
  address       String?
  logoUrl       String?
  timezone      String         @default("UTC")
  isActive      Boolean        @default(true)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         User[]
  doctors       Doctor[]
  patients      Patient[]
  appointments  Appointment[]
  services      Service[]
  workingHours  WorkingHours[]
  conversations Conversation[]
  callLogs      CallLog[]
  subscriptions Subscription[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
  treatments       Treatment[]
  careProtocols    CareProtocol[]
  careInstructions CareInstruction[]
  escalationRules  EscalationRule[]
  emergencyPhone           String?
  storeRawTriageMessages   Boolean                 @default(false)
  notificationConsents     NotificationConsent[]
  reminderJobs             ReminderJob[]
  triageLogs               TriageLog[]
  staffNotifications       StaffNotification[]

  @@index([deletedAt])
}

model User {
  id                  String               @id @default(uuid())
  clinicId            String?
  clinic              Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email               String
  passwordHash        String
  firstName           String
  lastName            String
  role                Role                 @default(STAFF)
  phone               String?
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  doctorProfile       Doctor?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  approvedProtocols   CareProtocol[]

  @@unique([clinicId, email])
  @@index([clinicId])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Doctor {
  id           String         @id @default(uuid())
  clinicId     String
  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  specialty    String?
  email        String?
  phone        String?
  bio          String?
  colorCode    String?        @default("#3B82F6")
  isActive     Boolean        @default(true)
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workingHours WorkingHours[]
  appointments Appointment[]

  @@index([clinicId])
}

model Service {
  id           String        @id @default(uuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  durationMins Int           @default(30)
  price        Decimal       @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  appointments Appointment[]

  @@index([clinicId])
}

model Patient {
  id           String        @id @default(uuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String?
  phone        String
  dateOfBirth  DateTime?
  gender       String?
  address      String?
  medicalNotes String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  appointments Appointment[]
  conversations Conversation[]
  callLogs     CallLog[]
  notificationConsents NotificationConsent[]
  reminderJobs         ReminderJob[]
  triageLogs           TriageLog[]
  staffNotifications   StaffNotification[]

  @@index([clinicId])
  @@index([phone])
  @@index([clinicId, phone])
}

model WorkingHours {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId  String?
  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([doctorId])
}

model Appointment {
  id           String            @id @default(uuid())
  clinicId     String
  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  treatmentId  String?
  treatment    Treatment?        @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(SCHEDULED)
  source       AppointmentSource @default(MANUAL)
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  reminderJobs       ReminderJob[]
  triageLogs         TriageLog[]
  staffNotifications StaffNotification[]

  @@index([clinicId])
  @@index([doctorId])
  @@index([patientId])
  @@index([treatmentId])
  @@index([startTime])
  @@index([clinicId, startTime])
  @@unique([doctorId, startTime, deletedAt])
}

model Conversation {
  id         String             @id @default(uuid())
  clinicId   String
  clinic     Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String?
  patient    Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  channel    String             @default("chat")
  status     ConversationStatus @default(ACTIVE)
  summary    String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  messages   Message[]

  @@index([clinicId])
  @@index([patientId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     String
  content        String
  tokensUsed     Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model CallLog {
  id           String     @id @default(uuid())
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId    String?
  patient      Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  callerPhone  String
  durationSecs Int        @default(0)
  status       CallStatus @default(COMPLETED)
  recordingUrl String?
  transcript   String?
  summary      String?
  sentiment    String?
  createdAt    DateTime   @default(now())

  @@index([clinicId])
  @@index([patientId])
  @@index([callerPhone])
}

model Subscription {
  id                     String             @id @default(uuid())
  clinicId               String             @unique
  clinic                 Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(TRIALING)
  billingPeriod          BillingPeriod      @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  razorpaySubscriptionId String?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  invoices               Invoice[]

  @@index([clinicId])
  @@index([planId])
}

model Invoice {
  id             String        @id @default(uuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  status         String
  invoicePdfUrl  String?
  paymentGateway String?
  paymentId      String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([clinicId])
}

model AuditLog {
  id         String   @id @default(uuid())
  clinicId   String?
  clinic     Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([clinicId])
  @@index([userId])
  @@index([createdAt])
}

model Treatment {
  id           String         @id @default(uuid())
  clinicId     String
  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  durationMins Int            @default(30)
  price        Decimal        @db.Decimal(10, 2)
  isActive     Boolean        @default(true)
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  careProtocols CareProtocol[]
  appointments  Appointment[]

  @@index([clinicId])
}

model CareProtocol {
  id               String             @id @default(uuid())
  clinicId         String
  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentId      String
  treatment        Treatment          @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  name             String
  status           CareProtocolStatus @default(DRAFT)
  approvedByUserId String?
  approvedByUser   User?              @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  version          Int                @default(1)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  instructions     CareInstruction[]
  escalationRules  EscalationRule[]

  @@unique([clinicId, treatmentId, version])
  @@index([clinicId])
  @@index([treatmentId])
}

model CareInstruction {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  protocolId    String
  protocol      CareProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  phase         CarePhase
  title         String
  body          String
  offsetMinutes Int
  category      CareCategory
  isCritical    Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  reminderJobs  ReminderJob[]

  @@index([clinicId])
  @@index([clinicId, protocolId])
}

model EscalationRule {
  id           String           @id @default(uuid())
  clinicId     String
  clinic       Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  protocolId   String?
  protocol     CareProtocol?    @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  symptomKey   String
  description  String
  action       EscalationAction
  message      String
  daysAfterMin Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clinicId])
  @@index([protocolId])
}

enum NotificationChannel {
  WHATSAPP
  SMS
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum ReminderJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

model NotificationConsent {
  id        String              @id @default(uuid())
  clinicId  String
  clinic    Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    ConsentStatus       @default(OPTED_IN)
  source    String?             @default("SYSTEM")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([clinicId, patientId, channel])
  @@index([clinicId])
  @@index([patientId])
}

model ReminderJob {
  id                String              @id @default(uuid())
  clinicId          String
  clinic            Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentId     String
  appointment       Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  instructionId     String
  instruction       CareInstruction     @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  sendAt            DateTime
  status            ReminderJobStatus   @default(PENDING)
  attempts          Int                 @default(0)
  lastError         String?
  skipReason        String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([appointmentId, instructionId, channel])
  @@index([status, sendAt])
  @@index([clinicId])
}

model TriageLog {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  symptomKeys   Json
  urgency       String       // "NONE" | "CONTACT_CLINIC" | "EMERGENCY"
  escalated     Boolean      @default(false)
  messageText   String?
  responseText  String?
  createdAt     DateTime     @default(now())

  @@index([clinicId])
  @@index([appointmentId])
}

model StaffNotification {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  title         String
  message       String
  severity      String       @default("HIGH") // "EMERGENCY" | "HIGH" | "WARNING" | "INFO"
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([clinicId])
  @@index([clinicId, isRead])
}
